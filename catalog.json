      "*.n64",
      "*.v64"
    ],
    "data": "~/.local/share/soh",
    "rom_hint": "Send your Ocarina of Time ROM with Frame Inbox, or put a .z64 in ~/.local/share/soh.",
    "prereleases": true,
    "mode": "game",
    "icon_url": "https://raw.githubusercontent.com/Cogential/Shipwright-frame/steam-frame/soh/macosx/sohIcon.png"
  },
  {
    "id": "2ship",
    "name": "Majora's Mask (2 Ship 2 Harkinian)",
    "repo": "Cogential/2ship2harkinian-frame",
    "asset": "*arm64.appimage",
    "type": "appimage",
    "gameid": "Majoras_Mask_2Ship",
    "launch": "run.sh",
    "keep": [
      "*.z64"
    ],
    "data": "~/.local/share/2ship",
    "rom_hint": "Send your Majora's Mask ROM with Frame Inbox, or put a .z64 in ~/.local/share/2ship.",
    "run_sh": [
      "#!/bin/sh",
      "# Steam Frame launcher for 2 Ship 2 Harkinian (written by Frametanium). Data, saves and the built mm.o2r",
      "# live in ~/.local/share/2ship, so reinstalling this folder keeps them.",
      "D=\"$(cd \"$(dirname \"$0\")\" && pwd)\"",
      "export SHIP_HOME=\"${SHIP_HOME:-$HOME/.local/share/2ship}\"",
      "mkdir -p \"$SHIP_HOME\"",
      "# Hand a ROM shipped next to this script to the extractor until mm.o2r exists.",
      "if [ ! -f \"$SHIP_HOME/mm.o2r\" ]; then",
      "    for rom in \"$D\"/*.z64; do [ -f \"$rom\" ] && cp -n \"$rom\" \"$SHIP_HOME/\"; done",
      "fi",
      "chmod +x \"$D/usr/bin/2s2h.elf\" 2>/dev/null",
      "cd \"$D/usr/bin\" && exec ./2s2h.elf \"$@\""
    ],
    "prereleases": true,
    "mode": "game",
    "icon_url": "https://raw.githubusercontent.com/Cogential/2ship2harkinian-frame/claude/focused-brahmagupta-sylmhh/mm/linux/2s2hIcon.png"
  },
