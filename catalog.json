[
  {
    "id": "soh",
    "name": "Ocarina of Time (Ship of Harkinian)",
    "repo": "Cogential/Shipwright-frame",
    "asset": "soh-steam-frame-arm64.zip",
    "type": "zip",
    "gameid": "Ocarina_of_Time_SoH",
    "launch": "run.sh",
    "keep": [
